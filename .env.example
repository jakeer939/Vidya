# Overwritten by `npm start` — LAN host is auto-detected (never type an IP).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=vidya
DB_PASSWORD=vidya
DB_NAME=vidya
PORT=4000
JWT_SECRET="dev-only-jwt-secret-change-me"
# Admin token for support + study-material management (send as x-admin-token)
ADMIN_TOKEN="vidya-admin-secret"
# Study material PDFs are stored here (relative to the API working directory).
# This directory is NOT served by the /uploads static route.
UPLOAD_DIR=./uploads/study-materials
MAX_PDF_SIZE_MB=50
# Windows only (if needed to create the vidya role): postgres superuser password
# VIDYA_PG_SUPER_PASSWORD=
